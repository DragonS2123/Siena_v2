{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "game_state.schema.json",
  "title": "GameState v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "session_id", "sequence", "captured_at", "game", "player", "companion", "environment"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^1\\.[0-9]+$"},
    "session_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "sequence": {"type": "integer", "minimum": 0},
    "captured_at": {"type": "string", "format": "date-time"},
    "source": {"type": "string", "enum": ["simulator", "cet"], "default": "simulator"},
    "bridge_version": {"type": ["string", "null"], "maxLength": 32, "default": null},
    "game": {"$ref": "#/$defs/game"},
    "player": {"$ref": "#/$defs/player"},
    "companion": {"$ref": "#/$defs/companion"},
    "environment": {"$ref": "#/$defs/environment"},
    "deep_game_state": {
      "anyOf": [{"$ref": "#/$defs/deep_game_state"}, {"type": "null"}],
      "default": null
    }
  },
  "$defs": {
    "position": {
      "type": "object", "additionalProperties": false, "required": ["x", "y", "z"],
      "properties": {"x": {"type": "number"}, "y": {"type": "number"}, "z": {"type": "number"}}
    },
    "game": {
      "type": "object", "additionalProperties": false, "required": ["running", "loaded", "paused"],
      "properties": {"running": {"type": "boolean"}, "loaded": {"type": "boolean"}, "paused": {"type": "boolean"}}
    },
    "player": {
      "type": "object", "additionalProperties": false,
      "required": ["health", "max_health", "in_combat", "in_vehicle", "position"],
      "properties": {
        "health": {"type": "number", "minimum": 0}, "max_health": {"type": "number", "exclusiveMinimum": 0},
        "in_combat": {"type": "boolean"}, "in_vehicle": {"type": "boolean"}, "position": {"$ref": "#/$defs/position"}
      }
    },
    "companion": {
      "type": "object", "additionalProperties": false,
      "required": ["present", "health", "max_health", "distance_to_player", "current_intent", "moving"],
      "properties": {
        "present": {"type": "boolean"}, "health": {"type": "number", "minimum": 0}, "max_health": {"type": "number", "exclusiveMinimum": 0},
        "distance_to_player": {"type": "number", "minimum": 0}, "current_intent": {"type": "string", "minLength": 1, "maxLength": 64}, "moving": {"type": "boolean"}
      }
    },
    "environment": {
      "type": "object", "additionalProperties": false,
      "required": ["district", "visible_hostiles", "highest_threat_id"],
      "properties": {
        "district": {"type": "string", "minLength": 1, "maxLength": 128}, "visible_hostiles": {"type": "integer", "minimum": 0},
        "highest_threat_id": {"type": ["string", "null"], "maxLength": 128}
      }
    },
    "deep_game_state": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "capabilities": {"anyOf": [{"$ref": "#/$defs/deep_capabilities"}, {"type": "null"}]},
        "player": {"anyOf": [{"$ref": "#/$defs/deep_player"}, {"type": "null"}]},
        "stats": {"anyOf": [{"$ref": "#/$defs/deep_stats"}, {"type": "null"}]},
        "stat_pools": {"anyOf": [{"$ref": "#/$defs/deep_stat_pools"}, {"type": "null"}]},
        "weapon": {"anyOf": [{"$ref": "#/$defs/deep_weapon"}, {"type": "null"}]},
        "status_effects": {"anyOf": [{"$ref": "#/$defs/deep_status_effects"}, {"type": "null"}]}
      }
    },
    "deep_capabilities": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "player": {"type": ["boolean", "null"]},
        "stats": {"type": ["boolean", "null"]},
        "stat_pools": {"type": ["boolean", "null"]},
        "weapon": {"type": ["boolean", "null"]},
        "status_effects": {"type": ["boolean", "null"]}
      }
    },
    "deep_player": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "entity_available": {"type": ["boolean", "null"]},
        "session_available": {"type": ["boolean", "null"]},
        "is_pre_game": {"type": ["boolean", "null"]},
        "position": {"anyOf": [{"$ref": "#/$defs/position"}, {"type": "null"}]},
        "mounted_vehicle": {"type": ["boolean", "null"]}
      }
    },
    "deep_stats": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "level": {"type": ["number", "null"]},
        "street_cred": {"type": ["number", "null"]},
        "armor": {"type": ["number", "null"]},
        "power_level": {"type": ["number", "null"]},
        "health": {"type": ["number", "null"]},
        "memory": {"type": ["number", "null"]}
      }
    },
    "deep_stat_pools": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "current_health": {"type": ["number", "null"], "minimum": 0},
        "maximum_health": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "current_memory": {"type": ["number", "null"], "minimum": 0},
        "maximum_memory": {"type": ["number", "null"], "exclusiveMinimum": 0}
      }
    },
    "deep_weapon": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "drawn": {"type": ["boolean", "null"]},
        "record_id": {"type": ["string", "null"], "maxLength": 256},
        "source": {"type": ["string", "null"], "enum": ["active", "weapon_right", "none", null]}
      }
    },
    "deep_status_effects": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "observed_count": {"type": ["integer", "null"], "minimum": 0},
        "truncated": {"type": ["boolean", "null"]},
        "limit": {"type": ["integer", "null"], "minimum": 1, "maximum": 256}
      }
    }
  }
}
